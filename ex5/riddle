vector<long> riddle(vector<long> arr) 
{
    int n = arr.size();

    // answer for every window size
    vector<long> ans(n + 1, 0);

    // previous smaller element
    vector<int> left(n);

    // next smaller element
    vector<int> right(n);


    // Find previous smaller element
    stack<int> st;

    for(int i = 0; i < n; i++)
    {
        while(!st.empty() && arr[st.top()] >= arr[i])
        {
            st.pop();
        }

        if(st.empty())
            left[i] = -1;
        else
            left[i] = st.top();

        st.push(i);
    }


    // Clear stack
    while(!st.empty())
        st.pop();


    // Find next smaller element
    for(int i = n-1; i >= 0; i--)
    {
        while(!st.empty() && arr[st.top()] >= arr[i])
        {
            st.pop();
        }

        if(st.empty())
            right[i] = n;
        else
            right[i] = st.top();

        st.push(i);
    }


    // Find window size where arr[i] is minimum
    for(int i = 0; i < n; i++)
    {
        int windowSize = right[i] - left[i] - 1;

        ans[windowSize] = max(ans[windowSize], arr[i]);
    }


    // Fill missing answers
    // Larger window cannot have greater answer than smaller window
    for(int i = n-1; i >= 1; i--)
    {
        ans[i] = max(ans[i], ans[i+1]);
    }


    // Remove index 0
    vector<long> result;

    for(int i = 1; i <= n; i++)
    {
        result.push_back(ans[i]);
    }

    return result;
}

